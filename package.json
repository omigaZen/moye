{
  "name": "moye-editor",
  "version": "0.5.0",
  "description": "墨页 · 专注书写的跨平台 Markdown 编辑器",
  "productName": "Moye",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "package": "node scripts/package.cjs",
    "prestart": "node scripts/prepare-assets.cjs",
    "test:performance": "node tests/editor-performance.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "archive:source": "python3 scripts/archive-source.py",
    "test:settings": "node tests/editor-settings.cjs",
    "test:math": "node tests/mathjax-offline.cjs",
    "verify:packages": "node scripts/verify-packages.cjs",
    "test:packaged:features": "node scripts/test-packaged-features.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "@mathjax/mathjax-bboldx-font-extension": "4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "mathjax": "4.1.3",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "playwright": "1.62.1"
  }
}
